{
  "name": "jat11-app",
  "version": "11.44.0",
  "description": "Desktop companion for the Job Application Tracker v11 Chrome extension. SQLite store, token-guarded REST + SSE on localhost:7744, AI layer (Codex CLI cloud / Ollama local), auto-apply queue, Gmail status sync.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "mirror": "node ../tools/mirror.mjs",
    "test": "node --test ../tests/status.test.mjs ../tests/fit.test.mjs ../tests/prompts.test.mjs ../tests/secrets.test.mjs ../tests/profile-memory.test.mjs ../tests/resume.test.mjs ../tests/autoapply.test.mjs ../tests/autoapply-breakdown.test.mjs ../tests/autoapply-policy.test.mjs ../tests/data-safety.test.mjs ../tests/safety-rail.test.mjs ../tests/observer-answers.test.mjs ../tests/observer-nav.test.mjs ../tests/recipe-transfer.test.mjs ../tests/ai-deterministic.test.mjs ../tests/recipe-replay.test.mjs ../tests/reward-match.test.mjs ../tests/rank-punish.test.mjs ../tests/apprentice-e2e.test.mjs ../tests/fill-scope.test.mjs ../tests/teach-schema.test.mjs ../tests/recorder.test.mjs ../tests/distill-selectors.test.mjs ../tests/teach-correct.test.mjs ../tests/teach-review.test.mjs ../tests/easyapply-limit.test.mjs ../tests/glassdoor.test.mjs ../tests/teach-e2e.test.mjs ../tests/teach-bugfix.test.mjs ../tests/harvest-lineage.test.mjs ../tests/discovery-provider.test.mjs ../tests/route-state.test.mjs ../tests/terminal-integrity.test.mjs ../tests/submit-truth.test.mjs ../tests/submit-quarantine.test.mjs ../tests/challenge.test.mjs ../tests/advance-keywords.test.mjs ../tests/external-ats.test.mjs ../tests/window-placement.test.mjs ../tests/opener-stall.test.mjs ../tests/search-url.test.mjs ../tests/freshness-ramp.test.mjs ../tests/workmode-normalize.test.mjs ../tests/breaker-reset-nav.test.mjs ../tests/linkedin-apply.test.mjs ../tests/resume-page.test.mjs ../tests/screening-answer.test.mjs ../tests/fuzzy-option.test.mjs ../tests/apply-cap.test.mjs ../tests/daily-cap.test.mjs ../tests/manifest-dynamic-url.test.mjs ../tests/redact-trace.test.mjs",
    "build": "electron-builder --publish never",
    "build:win": "electron-builder --win --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "publish:win": "electron-builder --win --publish always"
  },
  "dependencies": {
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "imapflow": "^1.4.0",
    "mailparser": "^3.9.9",
    "mammoth": "^1.8.0",
    "node-sqlite3-wasm": "^0.8.45",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "electron": "^32.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.pierre.jat11",
    "productName": "Job Application Tracker",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node-sqlite3-wasm/**"
    ],
    "extraResources": [
      {
        "from": "build/discovery",
        "to": "discovery",
        "filter": [
          "**/*"
        ]
      }
    ],
    "artifactName": "JAT-v11-${ext}",
    "protocols": [
      {
        "name": "Job Application Tracker",
        "schemes": [
          "jat11"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "src/icons/icon.ico",
      "artifactName": "JAT-v11-setup.${ext}"
    },
    "nsis": {
      "installerIcon": "src/icons/icon.ico",
      "uninstallerIcon": "src/icons/icon.ico",
      "installerHeaderIcon": "src/icons/icon.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Job Application Tracker"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/icons/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "icon": "src/icons/icon128.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "PierreSalama",
        "repo": "Job-ext-app",
        "releaseType": "release"
      }
    ]
  },
  "author": "Pierre",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PierreSalama/Job-ext-app.git"
  }
}